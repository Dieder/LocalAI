@page "/albums/{Id}/photos"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using PhotoIt.Data
@using CleanCode.AiOrchestration
@using AiFoundryLocal
@using Microsoft.AspNetCore.Components.Forms
@inject AlbumCatalog Catalog
@inject AzurePhotoStorage Storage
@inject PhotoVisionOrchestrator VisionOrchestrator
@inject Phi3VisionModel VisionModel
@inject PhotoIndexQueue IndexQueue
@inject NavigationManager Navigation

<PageTitle>Photos - @(album?.Name ?? "Album")</PageTitle>

@if (album is null)
{
    <div class="alert alert-warning">Album not found.</div>
    <a href="albums">Back to albums</a>
}
else
{
    <div class="mb-4">
        <a class="text-decoration-none" href="albums/@album.Id">&larr; Back to album</a>
        <h1 class="mt-3">Manage photos</h1>
        <p class="text-muted">@album.Name</p>
    </div>

    <div class="border rounded p-4 mb-4 bg-light">
        <label class="form-label" for="photo-upload">Upload photos</label>
        <InputFile id="photo-upload" OnChange="UploadAsync" multiple accept="image/*,.rw2" />
        <div class="form-text">Images are stored in Azure Blob Storage under @album.ImageFolderName.</div>

        @if (isUploading || uploadTotal > 0)
        {
            <div class="mt-3">
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>@uploadStatus</span>
                    <span>@uploadProgress / @uploadTotal</span>
                </div>
                <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@UploadPercent">
                    <div class="progress-bar" style="width: @UploadPercent%"></div>
                </div>
            </div>
        }

        @if (VisionModel.IsLoaded)
        {
            <div class="mt-3 d-flex align-items-center gap-3 flex-wrap">
                <button class="btn btn-outline-primary" type="button" @onclick="IndexTagsAsync" disabled="@isIndexing">
                    @(isIndexing ? "Indexing tags..." : "Index tags with vision model")
                </button>
                @if (!string.IsNullOrWhiteSpace(indexMessage))
                {
                    <span class="text-muted">@indexMessage</span>
                }
            </div>
        }
        else
        {
            <p class="mt-3 mb-0 text-muted"><em>Vision model is loading. Photo management is available now.</em></p>
        }

        @if (TaggingItems > 0)
        {
            <div class="mt-3">
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Background indexing</span>
                    <span>@TaggingComplete / @TaggingItems</span>
                </div>
                <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@TaggingPercent">
                    <div class="progress-bar" style="width: @TaggingPercent%"></div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mt-3 mb-0">@errorMessage</div>
        }
    </div>

    @if (photos.Count == 0)
    {
        <p class="text-muted">No photos uploaded yet.</p>
    }
    else
    {
        @foreach (var photoGroup in PhotoGroups)
        {
            <div class="mb-4">
                <h2 class="h5 mb-3">@photoGroup.Header</h2>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                    @foreach (var photo in photoGroup.Photos)
                    {
                        <div class="col">
                            <article class="card h-100 shadow-sm">
                                <img class="card-img-top" src="albums/@album.Id/photos/@photo.Id/content" alt="@photo.OriginalFileName" style="height: 180px; object-fit: cover;" />
                                <div class="card-body">
                                    <p class="card-text text-truncate" title="@photo.OriginalFileName">@photo.OriginalFileName</p>
                                    <small class="text-muted d-block">@FormatLength(photo.Length)</small>
                                    @if (photo.DateTakenUtc is not null)
                                    {
                                        <small class="text-muted d-block">Taken: @photo.DateTakenUtc.Value.ToLocalTime().ToString("ddd dd MMM yyyy")</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(photo.CameraMake) || !string.IsNullOrWhiteSpace(photo.CameraModel))
                                    {
                                        <small class="text-muted d-block">@GetCameraDisplay(photo)</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(photo.Description))
                                    {
                                        <p class="mt-2 mb-0 small" style="white-space: pre-wrap">@photo.Description</p>
                                    }
                                    @if (photo.Tags.Count > 0)
                                    {
                                        <div class="mt-2 d-flex flex-wrap gap-1" aria-label="Photo tags">
                                            @foreach (var tag in photo.Tags)
                                            {
                                                <span class="badge text-bg-secondary">@tag</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="card-footer bg-white border-0">
                                    @if (VisionModel.IsLoaded)
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => IndexPhotoAsync(photo)" disabled="@IsPhotoIndexing(photo)">
                                            @(IsPhotoIndexing(photo) ? "Analysing..." : "Index tags")
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(photo)">Delete</button>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            </div>
        }
    }
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Album? album;
    private IReadOnlyList<AlbumPhoto> photos = [];
    private bool isUploading;
    private bool isIndexing;
    private string? errorMessage;
    private string? indexMessage;
    private int uploadProgress;
    private int uploadTotal;
    private string uploadStatus = "Ready";
    private readonly HashSet<string> indexingPhotoIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource pageCts = new();
    private IEnumerable<DatePhotoGroup> PhotoGroups =>
        photos
            .GroupBy(GetPhotoGroupDate)
            .OrderByDescending(group => group.Key)
            .Select(group => new DatePhotoGroup(
                group.Key,
                group.Key.ToString("dddd d MMMM yyyy"),
                group.OrderByDescending(GetPhotoSortDate).ToList()));

    private static DateTime GetPhotoGroupDate(AlbumPhoto photo)
    {
        return AlbumCatalog.GetDisplayDate(photo.DateTakenUtc, photo.UploadedUtc).Date;
    }

    private static DateTime GetPhotoSortDate(AlbumPhoto photo)
    {
        return AlbumCatalog.GetDisplayDate(photo.DateTakenUtc, photo.UploadedUtc);
    }
    private int UploadPercent => uploadTotal == 0 ? 0 : (int)((uploadProgress / (double)uploadTotal) * 100);
    private int TaggingItems => photos.Count == 0 ? 0 : photos.Count;
    private int TaggingComplete => photos.Count(photo => photo.IndexedUtc is not null || photo.Tags.Count > 0);
    private int TaggingPercent => TaggingItems == 0 ? 0 : (int)((TaggingComplete / (double)TaggingItems) * 100);
    private sealed record DatePhotoGroup(DateTime Date, string Header, List<AlbumPhoto> Photos);

    protected override void OnInitialized()
    {
        album = Catalog.Get(Id);
        LoadPhotos();
        _ = WaitForModelAsync();
    }

    private async Task WaitForModelAsync()
    {
        try
        {
            while (!pageCts.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), pageCts.Token);
                LoadPhotos();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        if (album is null)
            return;

        var files = args.GetMultipleFiles(100).ToList();
        if (files.Count == 0)
            return;

        isUploading = true;
        uploadTotal = files.Count;
        uploadProgress = 0;
        uploadStatus = "Uploading...";
        errorMessage = null;

        try
        {
            foreach (var file in files)
            {
                var extension = Path.GetExtension(file.Name);
                var blobName = $"{album.ImageFolderName}/{Guid.NewGuid():N}{extension.ToLowerInvariant()}";
                await using var content = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
                using var memory = new MemoryStream();
                await content.CopyToAsync(memory);
                var bytes = memory.ToArray();

                var metadata = PhotoMetadataReader.Extract(bytes);
                await Storage.UploadAsync(blobName, new MemoryStream(bytes), file.ContentType, CancellationToken.None);

                var photo = new AlbumPhoto
                {
                    AlbumId = album.Id,
                    BlobName = blobName,
                    OriginalFileName = file.Name,
                    ContentType = file.ContentType,
                    Length = file.Size,
                    UploadedUtc = DateTime.UtcNow,
                    DateTakenUtc = metadata.DateTakenUtc,
                    Latitude = metadata.Latitude,
                    Longitude = metadata.Longitude,
                    CameraMake = metadata.CameraMake,
                    CameraModel = metadata.CameraModel,
                };

                Catalog.AddPhoto(photo);
                IndexQueue.Enqueue(new AlbumPhotoIndexRequest(album.Id, photo.Id));
                uploadProgress++;
                uploadStatus = $"Uploading {uploadProgress} of {uploadTotal}...";
                await InvokeAsync(StateHasChanged);
            }

            Catalog.Touch(album.Id);
            LoadPhotos();
            uploadStatus = "Completed";
        }
        catch (Exception exception)
        {
            errorMessage = $"Photo upload failed: {exception.Message}";
            uploadStatus = "Failed";
        }
        finally
        {
            isUploading = false;
            if (uploadProgress >= uploadTotal)
                uploadProgress = uploadTotal;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DeleteAsync(AlbumPhoto photo)
    {
        errorMessage = null;
        try
        {
            await Storage.DeleteAsync(photo.BlobName);
            Catalog.DeletePhoto(photo.Id);
            Catalog.Touch(Id);
            LoadPhotos();
        }
        catch (Exception exception)
        {
            errorMessage = $"Photo deletion failed: {exception.Message}";
        }
    }

    private async Task IndexTagsAsync()
    {
        if (album is null)
            return;

        isIndexing = true;
        errorMessage = null;
        indexMessage = null;
        try
        {
            var result = await VisionOrchestrator.IndexAlbumPhotosAsync(album.Id, Catalog, Storage);
            LoadPhotos();
            indexMessage = $"Indexed {result.Indexed}, skipped {result.Skipped}, failed {result.Failed}.";
            if (result.Failed > 0)
                errorMessage = "Some photos could not be indexed. Check the local ONNX model directory and runtime logs.";
        }
        catch (Exception exception)
        {
            errorMessage = $"Tag indexing failed. Check the local ONNX model directory and runtime logs: {exception.Message}";
        }
        finally
        {
            isIndexing = false;
        }
    }

    private async Task IndexPhotoAsync(AlbumPhoto photo)
    {
        errorMessage = null;
        indexMessage = null;
        try
        {
            indexingPhotoIds.Add(photo.Id);
            await InvokeAsync(StateHasChanged);
            await VisionOrchestrator.IndexPhotoAsync(photo, Catalog, Storage);
            LoadPhotos();
            indexMessage = $"Indexed {photo.OriginalFileName}.";
        }
        catch (Exception exception)
        {
            errorMessage = $"Tag indexing failed. Check the local ONNX model directory and runtime logs: {exception.Message}";
        }
        finally
        {
            indexingPhotoIds.Remove(photo.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void LoadPhotos()
    {
        photos = album is null ? [] : Catalog.ListPhotos(album.Id);
    }

    private bool IsPhotoIndexing(AlbumPhoto photo)
    {
        return isIndexing ||
               indexingPhotoIds.Contains(photo.Id) ||
               IndexQueue.IsPending(photo.Id);
    }

    private static string FormatLength(long length)
    {
        return length switch
        {
            < 1024 => $"{length} B",
            < 1024 * 1024 => $"{length / 1024d:0.0} KB",
            _ => $"{length / 1024d / 1024d:0.0} MB",
        };
    }

    private static string GetCameraDisplay(AlbumPhoto photo)
    {
        var camera = new[] { photo.CameraMake, photo.CameraModel }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .ToArray();

        return camera.Length == 0 ? "Camera unknown" : string.Join(" ", camera);
    }

    public ValueTask DisposeAsync()
    {
        pageCts.Cancel();
        pageCts.Dispose();
        return ValueTask.CompletedTask;
    }
}