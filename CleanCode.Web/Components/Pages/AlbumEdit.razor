@page "/albums/{Id}/edit"
@rendermode InteractiveServer
@using PhotoIt.Data
@inject AlbumCatalog Catalog
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@using CleanCode.Web.Components
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
<PageTitle>Edit album</PageTitle>
<AlbumEdit />
@if (model is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mb-4">
        <a class="text-decoration-none" href="albums/@Id">&larr; Back to album</a>
        <h1 class="mt-3">Edit album</h1>
    </div>

    <AlbumForm Model="model" SubmitLabel="Save changes" />
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private AlbumFormModel? model;

    protected override async Task OnInitializedAsync()
    {
        var album = Catalog.Get(Id);
        if (album is null)
        {
            Navigation.NavigateTo("albums");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var currentUserId = CurrentUserHelper.GetUserId(authState.User);
        if (currentUserId != album.UserId)
        {
            Navigation.NavigateTo($"albums/{album.Id}");
            return;
        }

        model = new AlbumFormModel
        {
            Id = album.Id,
            CreatedUtc = album.CreatedUtc,
            UpdatedUtc = album.UpdatedUtc,
            Intro = album.Intro,
            Name = album.Name,
            ImageFolderName = album.ImageFolderName,
            FullDescription = album.FullDescription,
        };
    }
}
