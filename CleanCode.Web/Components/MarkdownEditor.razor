@using Markdig

<div class="row">
    <div class="col-6">
        <textarea class="form-control"
                  rows="15"
                  @bind="Value">
        </textarea>
    </div>

    <div class="col-6">
        <div class="border rounded p-3">
            @((MarkupString)Markdown.ToHtml(Value ?? ""))
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }
}
