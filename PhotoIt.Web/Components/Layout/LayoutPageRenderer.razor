@using PhotoIt.Data
@inject IJSRuntime JS

<div class="@(IsTitlePage ? "layout-page-renderer title-page" : "layout-paper")" style="--paper-ratio: @PageAspectRatio;">
    @if (IsTitlePage)
    {
        <div class="title-page-content">
            <div class="title-page-text">
                <h2 class="title-page-heading">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p class="title-page-subtitle">@Subtitle</p>
                }
            </div>
            <div class="title-page-cover @(Editable ? "editable-slot" : "")"
                 @ondragover="AllowDrop"
                 @ondrop="() => HandleCoverDrop()"
                 @ondrop:preventDefault
                 @ondragover:preventDefault>
                @if (!string.IsNullOrWhiteSpace(CoverPhotoId))
                {
                    <div class="slot-photo @(Editable ? "draggable" : "")"
                         draggable="@Editable"
                         @ondragstart="() => HandleSlotDragStart(0, 0, CoverPhotoId!)">
                        <img src="@GetPhotoUrl(CoverPhotoId!)" alt="Cover photo" />
                        @if (Editable)
                        {
                            <button type="button" class="slot-remove btn btn-sm btn-dark" @onclick="HandleCoverRemove" @onclick:stopPropagation="true">×</button>
                        }
                    </div>
                }
                else if (Editable)
                {
                    <span class="slot-placeholder">Drop cover photo</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="layout-page-renderer @(PresentationMode ? "presentation-mode" : "")"
            style="--cols: @Template.Columns; --rows: @Template.Rows; --page-ratio: @PageAspectRatio; --paper-ratio: @PaperAspectRatio;">
            @foreach (var slot in Template.Slots.OrderBy(s => s.Row).ThenBy(s => s.Col))
            {
                var placedSlot = Photos.FirstOrDefault(item => item.Col == slot.Col && item.Row == slot.Row);
                var photoId = placedSlot?.PhotoId;

                <div class="layout-slot size-@slot.Type.Id"
                     style="grid-column: @slot.Col / span @slot.ColSpan;
                    grid-row:    @slot.Row / span @slot.RowSpan;"
                     @ondragover="AllowDrop"
                     @ondrop="() => HandleSlotDrop(slot.Col, slot.Row)"
                     @ondrop:preventDefault
                     @ondragover:preventDefault>
                    <div class="slot-frame size-@slot.Type.Id @(IsFullPageSlot(slot) ? "full-page-slot" : "")"
                         >

                    @if (!string.IsNullOrWhiteSpace(photoId) && IsPhotoCompatible(slot, photoId))
                    {
                         <div class="slot-photo @(Editable ? "draggable" : "")"
                             @onpointerdown="(args) => BeginPhotoPositionDrag(args, placedSlot ?? slot)"
                             @onpointermove="HandlePhotoPositionMove"
                             @onpointerup="EndPhotoPositionDrag"
                             @onpointercancel="EndPhotoPositionDrag"
                             @onpointerdown:preventDefault="true">

                             <img src="@GetPhotoUrl(photoId!)"
                                 alt="@GetPhotoName(photoId!)"
                                  class="photo-img @GetPhotoFitClass(photoId!)"
                                      style="transform: @GetPhotoTransform(placedSlot, slot);" />

                             @if (Editable)
                             {
                                  <button type="button"
                                          class="slot-drag-handle btn btn-sm btn-dark"
                                          draggable="true"
                                          aria-label="Move photo to another slot"
                                          title="Drag to another slot"
                                          @ondragstart="() => HandleSlotDragStart(slot.Col, slot.Row, photoId!)"
                                          @onpointerdown:stopPropagation="true"
                                          @onclick:stopPropagation="true">⠿</button>
                                  <div class="zoom-controls" @onpointerdown:stopPropagation="true" @onclick:stopPropagation="true">
                                     <button type="button" class="btn btn-sm btn-dark" @onclick="() => ChangeZoom(placedSlot!, -ZoomStep)" disabled="@(placedSlot!.Zoom <= MinZoom)">−</button>
                                     <span class="zoom-level">@((placedSlot!.Zoom * 100).ToString("0"))%</span>
                                     <button type="button" class="btn btn-sm btn-dark" @onclick="() => ChangeZoom(placedSlot!, ZoomStep)" disabled="@(placedSlot!.Zoom >= MaxZoom)">+</button>
                                      <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => ResetZoom(placedSlot!)">Reset</button>
                                 </div>
                             }

                            @if (Editable)
                            {
                                <button type="button"
                                        class="slot-remove btn btn-sm btn-dark"
                                        @onclick="() => HandleSlotRemove(slot.Col, slot.Row)"
                                         @onpointerdown:stopPropagation="true"
                                        @onclick:stopPropagation="true">
                                    ×
                                </button>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(photoId))
                    {
                        <span class="slot-placeholder slot-invalid">Photo does not fit this slot</span>
                    }
                    else if (Editable)
                    {
                        <span class="slot-placeholder">Drop photo</span>
                    }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string AlbumId { get; set; } = string.Empty;

    [Parameter]
    public bool IsTitlePage { get; set; }

    [Parameter]
    public string TemplateId { get; set; } = LayoutTemplateIds.OneBig;

    [Parameter]
    public IReadOnlyList<PhotoSlot> Photos { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, AlbumPhoto> PhotoLookup { get; set; } = new Dictionary<string, AlbumPhoto>();

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Subtitle { get; set; } = string.Empty;

    [Parameter]
    public string? CoverPhotoId { get; set; }

    [Parameter]
    public bool Editable { get; set; }

    [Parameter]
    public bool PresentationMode { get; set; }

    [Parameter]
    public EventCallback<LayoutDropEventArgs> OnPhotoDropped { get; set; }

    [Parameter]
    public EventCallback<LayoutDragStartEventArgs> OnPhotoDragStarted { get; set; }

    [Parameter]
    public EventCallback<LayoutRemoveEventArgs> OnPhotoRemoved { get; set; }

    [Parameter]
    public EventCallback<LayoutZoomChangedEventArgs> OnZoomChanged { get; set; }

    [Parameter]
    public EventCallback<LayoutPositionChangedEventArgs> OnPositionChanged { get; set; }

    [Parameter]
    public int? PageNumber { get; set; }

    private LayoutTemplate? Template => LayoutTemplates.Get(TemplateId);
    private double PageAspectRatio => Template is { } template
        ? GetPageAspectRatio(template)
        : 1d;

    private double PaperAspectRatio => TemplateId switch
    {
        LayoutTemplateIds.PaginaSquare => 1d,
        LayoutTemplateIds.PaginaFull => 297d / 210d,
        _ when PageAspectRatio > 1d => 297d / 210d,
        _ => 210d / 297d
    };

    private static double GetPageAspectRatio(LayoutTemplate template)
    {
        if (template.Slots.Count == template.Columns * template.Rows
            && template.Slots.All(slot => slot.ColSpan == 1 && slot.RowSpan == 1)
            && template.Slots.Select(slot => slot.Type.Id).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1)
        {
            return template.Columns * template.Slots[0].Type.AspectRatio / template.Rows;
        }

        if (template.Slots.Count == 1
            && template.Slots[0].ColSpan == template.Columns
            && template.Slots[0].RowSpan == template.Rows)
        {
            return template.Slots[0].Type.AspectRatio;
        }

        return template.Columns / (double)template.Rows;
    }

    private static bool IsFullPageSlot(PhotoSlot slot) =>
        slot.ColSpan > 1 || slot.RowSpan > 1 || slot.Type.Id is "paginaL";
    private const double ZoomStep = 0.25d;
    private const double MinZoom = 0.5d;
    private const double MaxZoom = 3d;
    private PhotoSlot? activePositionSlot;
    private double activePositionStartX;
    private double activePositionStartY;
    private double activePositionWidth;
    private double activePositionHeight;
    private double activePositionPointerX;
    private double activePositionPointerY;

    

    private string GetPhotoUrl(string photoId)
    {
        return $"albums/{AlbumId}/photos/{photoId}/content";
    }

    private string GetPhotoName(string photoId)
    {
        return PhotoLookup.TryGetValue(photoId, out var photo)
            ? photo.OriginalFileName
            : "Photo";
    }

    private static void AllowDrop(DragEventArgs _) { }

    private async Task BeginPhotoPositionDrag(PointerEventArgs args, PhotoSlot slot)
    {
        if (!Editable || string.IsNullOrWhiteSpace(slot.PhotoId))
            return;

        var size = await JS.InvokeAsync<SlotSize>("layoutEditor.getElementSizeAtPoint", args.ClientX, args.ClientY);
        activePositionSlot = slot;
        activePositionStartX = slot.PositionX;
        activePositionStartY = slot.PositionY;
        activePositionWidth = Math.Max(1d, size.Width);
        activePositionHeight = Math.Max(1d, size.Height);
        activePositionPointerX = args.ClientX;
        activePositionPointerY = args.ClientY;
    }

    private void HandlePhotoPositionMove(PointerEventArgs args)
    {
        if (activePositionSlot is null || args.Buttons == 0)
            return;

        activePositionSlot.PositionX = Clamp(activePositionStartX +
            (args.ClientX - activePositionPointerX) / activePositionWidth * 100d);
        activePositionSlot.PositionY = Clamp(activePositionStartY +
            (args.ClientY - activePositionPointerY) / activePositionHeight * 100d);
        _ = OnPositionChanged.InvokeAsync(new LayoutPositionChangedEventArgs(
            activePositionSlot.Col,
            activePositionSlot.Row,
            IsTitlePage,
            activePositionSlot.PositionX,
            activePositionSlot.PositionY));
        StateHasChanged();
    }

    private void EndPhotoPositionDrag(PointerEventArgs _)
    {
        activePositionSlot = null;
    }

    private static double Clamp(double value) => Math.Clamp(value, 0d, 100d);

    private string GetPhotoFitClass(string photoId) =>
        PhotoLookup.TryGetValue(photoId, out var photo)
        && photo.PixelWidth is > 0
        && photo.PixelHeight is > 0
            ? "photo-fit-calculated"
            : "photo-fit-cover";

    private string GetPhotoTransform(PhotoSlot? slot, PhotoSlot targetSlot)
    {
        var zoom = GetRenderedZoom(slot, targetSlot);
        var positionX = slot?.PositionX ?? 50d;
        var positionY = slot?.PositionY ?? 50d;
        var offsetX = (50d - positionX) * (zoom - 1d);
        var offsetY = (50d - positionY) * (zoom - 1d);

        return $"translate({offsetX.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%, {offsetY.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%) scale({zoom.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)})";
    }

    private double GetRenderedZoom(PhotoSlot? slot, PhotoSlot targetSlot)
    {
        var userZoom = slot?.Zoom ?? 1d;
        if (slot?.PhotoId is not string photoId
            || !PhotoLookup.TryGetValue(photoId, out var photo)
            || photo.PixelWidth is not int photoWidth
            || photo.PixelHeight is not int photoHeight
            || photoWidth <= 0
            || photoHeight <= 0)
        {
            return userZoom;
        }

        var photoRatio = photoWidth / (double)photoHeight;
        var slotRatio = GetRenderedSlotAspectRatio(targetSlot);
        var widthFit = slotRatio / photoRatio;
        var coverScale = Math.Max(widthFit, 1d);
        var containScale = Math.Min(widthFit, 1d);
        var coverFitZoom = coverScale / containScale;

        return coverFitZoom * userZoom;
    }

    private double GetRenderedSlotAspectRatio(PhotoSlot slot)
    {
        if (Template is not { } template || template.Columns <= 0 || template.Rows <= 0)
            return Math.Max(slot.Type.AspectRatio, 0.01d);

        return Math.Max(0.01d,
            PageAspectRatio
            * slot.ColSpan / (double)template.Columns
            * template.Rows / (double)slot.RowSpan);
    }

    private bool IsPhotoCompatible(PhotoSlot slot, string photoId) =>
        !PhotoLookup.TryGetValue(photoId, out var photo)
        || PhotoType.IsCompatible(slot.Type.Id, photo.PixelWidth, photo.PixelHeight);

    private sealed record SlotSize(double Width, double Height);

    private Task HandleSlotDragStart(int slotCol, int slotRow, string photoId)
    {
        return OnPhotoDragStarted.InvokeAsync(new LayoutDragStartEventArgs(photoId, slotCol, slotRow, IsTitlePage, PageNumber));
    }

    private Task HandleSlotDrop(int slotCol, int slotRow)
    {
        return OnPhotoDropped.InvokeAsync(new LayoutDropEventArgs(slotCol, slotRow, IsTitlePage));
    }

    private Task HandleCoverDrop()
    {
        return OnPhotoDropped.InvokeAsync(new LayoutDropEventArgs(0, 0, true));
    }

    private Task HandleSlotRemove(int slotCol, int slotRow)
    {
        return OnPhotoRemoved.InvokeAsync(new LayoutRemoveEventArgs(slotCol, slotRow, false));
    }

    private Task ChangeZoom(PhotoSlot slot, double delta)
    {
        slot.Zoom = Math.Clamp(Math.Round(slot.Zoom + delta, 2), MinZoom, MaxZoom);
        return OnZoomChanged.InvokeAsync(new LayoutZoomChangedEventArgs(slot.Col, slot.Row, IsTitlePage, slot.Zoom));
    }

    private Task ResetZoom(PhotoSlot slot)
    {
        slot.Zoom = 1d;
        return OnZoomChanged.InvokeAsync(new LayoutZoomChangedEventArgs(slot.Col, slot.Row, IsTitlePage, slot.Zoom));
    }

    private Task HandleCoverRemove()
    {
        return OnPhotoRemoved.InvokeAsync(new LayoutRemoveEventArgs(0, 0, true));
    }
}
