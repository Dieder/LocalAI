@using PhotoIt.Data
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<div class="template-selector">
    <div class="templates-grid">
        @if (Templates is null || Templates.Count == 0)
        {
            <div class="no-templates">No templates available</div>
        }
        else
        {
            @foreach (var template in Templates)
            {
                var isSelected = template.Id == SelectedTemplateId;
                var isLocked = PageHasPhotos && !isSelected;
                var svg = template.ToSvg();
                <div class="template-card @(isSelected ? "selected" : "") @(isLocked ? "locked" : "")"
                     role="button"
                     tabindex="@(isLocked ? -1 : 0)"
                     aria-pressed="@isSelected"
                     aria-disabled="@isLocked"
                     @onclick="() => SelectTemplate(template.Id, isLocked)"
                     @onkeypress="(e) => OnKeyPress(e, template.Id)">

                    
                    <div class="template-preview">
                        @((MarkupString)svg)
                    </div>
                    <div class="template-name">@template.Name</div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public List<LayoutTemplate>? Templates { get; set; }

    [Parameter]
    public string? SelectedTemplateId { get; set; }

    [Parameter]
    public bool PageHasPhotos { get; set; }

    [Parameter]
    public EventCallback<string> SelectedTemplateIdChanged { get; set; }

    private async Task SelectTemplate(string id, bool isLocked = false)
    {
        if (isLocked || string.IsNullOrWhiteSpace(id) || id == SelectedTemplateId)
            return;

        SelectedTemplateId = id;
        if (SelectedTemplateIdChanged.HasDelegate)
            await SelectedTemplateIdChanged.InvokeAsync(id);
    }

    private async Task OnKeyPress(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter" || e.Key == " ")
            await SelectTemplate(id, PageHasPhotos && id != SelectedTemplateId);
    }

    private (double X, double Y, double Width, double Height) GetRectForSize(string size)
    {
        return size switch
        {
            "full" => (5, 5, 90, 90),
            "panorama" => (5, 6, 90, 38),
            "landscape" => (5, 5, 90, 42),
            "portrait" => (5, 5, 46, 90),
            "portrait-tall" => (5, 5, 50, 90),
            "small" => (5, 5, 28, 28),
            "equal" => (5, 5, 42, 42),
            _ => (5, 5, 90, 90)
        };
    }
}
