@page "/travelroute/{AlbumId}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using PhotoIt.Core.Services
@inject AlbumCatalog Catalog
@inject NominatimClient NominatimClient
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

@inject IJSRuntime JS

<div class="row">

    <div class="col-md-4">

        <h4>Route Editor</h4>

        @foreach (var leg in Model.Legs.Select((item, index) => new { item, index }))
        {
            <div class="card mb-2">
                <div class="card-body">

                    <div class="mb-2">
                        <label>Van</label>
                        <input class="form-control"
                               @bind="leg.item.From.Place"
                               @onblur="async (e) => await OnPlaceChanged(leg.item.From)" />
                    </div>
                    <span title="@(leg.item.From.FoundName ?? "Not found")">
                        @(leg.item.From.HasGeoPoint() ? "📍" : "❌")
                    </span>
                    
                    <div class="mb-2">
                        <label>Naar</label>
                        <input class="form-control"
                               @bind="leg.item.To.Place"
                               @onblur="async (e) => await OnPlaceChanged(leg.item.To)" />
                    </div>
                    <span title="@(leg.item.To.FoundName ?? "Not Found")">
                        @(leg.item.To.HasGeoPoint() ? "📍" : "❌")
                    </span>

                    <div class="mb-2">
                        <label>Transport</label>

                        <InputSelect class="form-select"
                                     @bind-Value="leg.item.Transport">

                            @foreach (var transport in Enum.GetValues<TransportType>())
                            {
                                <option value="@transport">
                                    @GetTransportText(transport)
                                </option>
                            }

                        </InputSelect>
                    </div>
                                        <button class="btn btn-danger btn-sm"
                            @onclick="() => RemoveLeg(leg.index)">
                        Verwijderen
                    </button>

                </div>
            </div>
        }

        <button class="btn btn-primary"
                @onclick="AddLeg">
            + Leg toevoegen
        </button>

        <button class="btn btn-success ms-2"
                @onclick="RefreshMap">
            Kaart bijwerken
        </button>

    </div>

    <div class="col-md-8">
        <div id="travelMap" style="height:800px;"></div>
    </div>

</div>

@code {

    [Parameter]
    public string AlbumId { get; set; } = string.Empty;
    private Album album;

    private TripGraph Model = new();
    private AuthenticationState authenticationState;

    protected override async Task OnInitializedAsync()
    {
        authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = CurrentUserHelper.GetUserId(authenticationState.User);
        if (string.IsNullOrEmpty(email))
        {
            throw new InvalidOperationException("User is not authenticated.");
        }
        if (string.IsNullOrEmpty(AlbumId))
        {
            throw new InvalidOperationException("AlbumId parameter is required.");
        }
        album = Catalog.Get(AlbumId) ?? throw new InvalidDataException("Album not found");
        Model = album.TripGraph ?? new TripGraph();      
        Model.Legs.Add(new RouteLeg
        {
            From = new RoutePoint(),
            To = new RoutePoint(),
            Transport = TransportType.Car
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            await JS.InvokeVoidAsync(
                "travelMap.initialize",
                Model.Legs);
        }
    }

    private void AddLeg()
    {
        var lastLeg = Model.Legs.Last().To;
        var newFrom = new RoutePoint
            {
                Place = lastLeg.Place,
                Latitude = lastLeg.Latitude,
                Longitude = lastLeg.Longitude,
                FoundName = lastLeg.FoundName,
                Country = lastLeg.Country
            }; 
        Model.Legs.Add(new RouteLeg
        {
            From = newFrom,
            To = new RoutePoint(),
            Transport = TransportType.Car
        });
        StateHasChanged();
    }

    private void RemoveLeg(int index)
    {
        Model.Legs.RemoveAt(index);
        StateHasChanged();
    }

    private async Task RefreshMap()
    {
        if (Model.Legs.All(leg => leg.From.HasGeoPoint() && leg.To.HasGeoPoint()))        
        {
            // save Model to database or perform any other necessary actions here
            Model.UpdatedUtc = DateTime.UtcNow;
            album.TripGraph = Model;            
            Catalog.Update(album);
            await JS.InvokeVoidAsync(
           "travelMap.refresh",
           Model);
        }
        else
        {
            // show alert to user that some points are missing
            await JS.InvokeVoidAsync("alert", "Some points are missing geo-coordinates. Please check the input fields.");
        }   
       
        StateHasChanged();
    }

    private string GetTransportText(TransportType type)
    {
        return type switch
        {
            TransportType.Car => "🚗 Auto",
            TransportType.Plane => "✈️ Vliegtuig",
            TransportType.Boat => "⛵ Boot",
            TransportType.Walking => "🚶 Wandeling",
            TransportType.Bicycle => "🚴 Fiets",
            _ => type.ToString()
        };
    }

    private async Task OnPlaceChanged(RoutePoint point)
    {
        if (point.Place == null || point.Place.Length < 3)
        {
            point.ResetGeo();
            return;
        };

        if (point.Place == point.Id)
        {
            return;
        }
        
        var result = await NominatimClient.ResolvePlaceAsync(point.Place);
        point.ResetGeo();
        if (result != null)
        {
            point.Id = point.Place;
            point.FoundName = result.Name;
            point.Country = result.Country;
            point.Latitude = result.Latitude;
            point.Longitude = result.Longitude;
        
        }

        StateHasChanged();
    }

}