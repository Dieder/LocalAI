@page "/travelroute/{AlbumId}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using PhotoIt.Core.Services
@inject AlbumCatalog Catalog
@inject NominatimClient NominatimClient
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a class="text-decoration-none" href="/albums/@AlbumId">&larr; Back to album</a>
        <h1 class="h3 mt-2 mb-0">Route Editor</h1>
    </div>
</div>

<div class="row">

    <div class="col-md-4">

        @foreach (var leg in Model.Legs.Select((item, index) => new { item, index }))
        {
            <div class="card mb-2">

                <div class="card-body">

                    @if (!leg.item.IsEditing)
                    {
                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <strong>@leg.item.From.Place</strong>
                                →
                                <strong>@leg.item.To.Place</strong>

                                <span class="ms-2">
                                    @GetTransportIcon(leg.item.Transport)
                                </span>

                            </div>

                            <div>

                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => leg.item.IsEditing = true">
                                    ✏️
                                </button>

                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => RemoveLeg(leg.index)">
                                    🗑️
                                </button>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="mb-2">

                            <label>Van</label>

                            <input class="form-control"
                                   @bind="leg.item.From.Place"
                                   @onblur="async (e) => await OnPlaceChanged(leg.item.From)" />

                            <small title="@(leg.item.From.FoundName ?? "Not found")">
                                @(leg.item.From.HasGeoPoint() ? "📍" : "❌")
                            </small>

                        </div>

                        <div class="mb-2">

                            <label>Naar</label>

                            <input class="form-control"
                                   @bind="leg.item.To.Place"
                                   @onblur="async (e) => await OnPlaceChanged(leg.item.To)" />

                            <small title="@(leg.item.To.FoundName ?? "Not found")">
                                @(leg.item.To.HasGeoPoint() ? "📍" : "❌")
                            </small>

                        </div>

                        <div class="mb-2">

                            <label>Transport</label>

                            <InputSelect class="form-select"
                                         @bind-Value="leg.item.Transport">

                                @foreach (var transport in Enum.GetValues<TransportType>())
                                {
                                    <option value="@transport">
                                        @GetTransportText(transport)
                                    </option>
                                }

                            </InputSelect>

                        </div>

                        <div class="d-flex justify-content-between">

                            <button class="btn btn-success btn-sm"
                                    @onclick="() => leg.item.IsEditing = false">
                                ✅
                            </button>

                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => RemoveLeg(leg.index)">
                                🗑️
                            </button>

                        </div>
                    }

                </div>

            </div>
        }

        <button class="btn btn-primary"
                @onclick="AddLeg">
            + Leg toevoegen
        </button>

        <button class="btn btn-success ms-2"
                @onclick="RefreshMap">
            Kaart bijwerken
        </button>

    </div>

    <div class="col-md-8">
        <div id="travelMap" style="height:800px;"></div>
    </div>

</div>

@code {

    [Parameter]
    public string AlbumId { get; set; } = string.Empty;
    private Album album;

    private TripGraph Model = new();
    private AuthenticationState authenticationState;

    protected override async Task OnInitializedAsync()
    {
        authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = CurrentUserHelper.GetUserId(authenticationState.User);
        if (string.IsNullOrEmpty(email))
        {
            throw new InvalidOperationException("User is not authenticated.");
        }
        if (string.IsNullOrEmpty(AlbumId))
        {
            throw new InvalidOperationException("AlbumId parameter is required.");
        }

        album = Catalog.Get(AlbumId) ?? throw new InvalidDataException("Album not found");
        Model = album.TripGraph ?? new TripGraph();
        Model.Legs.Where(x=>x.IsValid()).ToList().ForEach(leg =>
        {
            leg.IsEditing = false;           
        });

        if (Model.Legs.Count == 0)
        {
            Model.Legs.Add(new RouteLeg
                {
                IsEditing = true,
                    From = new RoutePoint(),
                    To = new RoutePoint(),
                    Transport = TransportType.Car
                });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            await JS.InvokeVoidAsync(
                "travelMap.initialize",
                Model.Legs);
        }
    }

    private void AddLeg()
    {
        var lastLeg = Model.Legs.Last();
        lastLeg.IsEditing = false;
        var lastTo = lastLeg.To;
        var newFrom = new RoutePoint
        {
            Place = lastTo.Place,
            Latitude = lastTo.Latitude,
            Longitude = lastTo.Longitude,
            FoundName = lastTo.FoundName,
            Country = lastTo.Country
        };
        Model.Legs.Add(new RouteLeg
        {
            IsEditing = true,
            From = newFrom,
            To = new RoutePoint(),
            Transport = TransportType.Car
        });
        StateHasChanged();
    }

    private void RemoveLeg(int index)
    {
        if (index==0)
        {
            return;
        }
        Model.Legs.RemoveAt(index);
        Model.Legs.Skip(index - 1).First().IsEditing = true;
        StateHasChanged();
    }

    private async Task RefreshMap()
    {
        if (Model.Legs.All(leg => leg.IsValid()))
        {
            // save Model to database or perform any other necessary actions here
            Model.UpdatedUtc = DateTime.UtcNow;
            foreach(var leg in Model.Legs.Where(x=>x.IsEditing))
            {
                leg.IsEditing = false;
            }
            album.TripGraph = Model;
            Catalog.Update(album);
            await JS.InvokeVoidAsync(
           "travelMap.refresh",
           Model);
        }
        else
        {
            // show alert to user that some points are missing
            await JS.InvokeVoidAsync("alert", "Some points are missing geo-coordinates. Please check the input fields.");
        }

        StateHasChanged();
    }

    private string GetTransportIcon(TransportType type)
    {
        return type switch
        {
            TransportType.Car => "🚗",
            TransportType.Plane => "✈",
            TransportType.Boat => "⛵",
            TransportType.Walking => "🚶",
            TransportType.Bicycle => "🚴",
            _ => "❓"
        };
    }

    private string GetTransportText(TransportType type)
    {
        return type switch
        {
            TransportType.Car => "🚗 Auto",
            TransportType.Plane => "✈️ Vliegtuig",
            TransportType.Boat => "⛵ Boot",
            TransportType.Walking => "🚶 Wandeling",
            TransportType.Bicycle => "🚴 Fiets",
            _ => "❓"
        };
    }

    private async Task OnPlaceChanged(RoutePoint point)
    {
        if (point.Place == null || point.Place.Length < 3)
        {
            point.ResetGeo();
            return;
        }
        ;

        if (point.Place == point.Id)
        {
            return;
        }

        var result = await NominatimClient.ResolvePlaceAsync(point.Place);
        point.ResetGeo();
        if (result != null)
        {
            point.Id = point.Place;
            point.FoundName = result.Name;
            point.Country = result.Country;
            point.Latitude = result.Latitude;
            point.Longitude = result.Longitude;

        }

        StateHasChanged();
    }

}